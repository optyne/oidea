DATABASE_URL="postgresql://oidea:oidea_secret_dev@localhost:5433/oidea?schema=public"
REDIS_HOST="localhost"
REDIS_PORT=6379
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="oidea_minio"
MINIO_SECRET_KEY="oidea_minio_secret_dev"
MINIO_BUCKET="oidea-uploads"
JWT_SECRET="dev-jwt-secret-change-in-production"
# access token（JWT，typ=access）有效期；不設時預設 15m
JWT_EXPIRATION="15m"
# refresh token（不透明字串，DB 只存 sha256）有效期；每次 refresh 重新起算。格式：7d / 12h / 30m / 秒數
JWT_REFRESH_EXPIRATION="7d"
PORT=3001

# ── Redis 連線（管理型 Redis 通常會開 AUTH）────────────────────────────
REDIS_PASSWORD=""
REDIS_USERNAME=""

# ── Oidea AI 助手（@ai 在 chat 觸發，走自家 b300 OpenAI 相容端點）─────
# 若不要 AI 功能：AI_ENABLED=false，或不設 AI_BASE_URL
AI_ENABLED="true"
AI_BASE_URL=""                 # 例：https://b300.powerchampion.ai/v1
AI_API_KEY=""
AI_MODEL=""                    # 以 b300 /v1/models 實際回傳的 id 為準
AI_RATE_LIMIT_PER_HOUR="10"    # 每個使用者每小時最多 @ai 次數

# ── 反向代理（Traefik / Cloudflare）────────────────────────────────────
# 不設 = 不信任代理（原本行為）。數字 = 信任的代理跳數。
# 正確值必須先在 staging 實測：比對 req.ip（audit log 的 ipAddress）與實際客戶端 IP，
# 步驟見 docs/DEPLOY_DOKPLOY.md「反向代理與 TRUST_PROXY」。不要用 true。
TRUST_PROXY=""

# ── 登入方式（H1）────────────────────────────────────────────────────
# 帳密登入／註冊開關。不設時：NODE_ENV=production 為 false，其他為 true。
# 關閉時 POST /auth/register 與 /auth/login 回 404（緊急登入名單上的公司 owner 例外）。
# 接受 true/false/1/0/yes/no/on/off；無法辨識的值當 false。
AUTH_PASSWORD_LOGIN_ENABLED=""
# 緊急登入（break-glass）：Authentik 或 Mailcow 掛掉時才設。逗號分隔、不分大小寫。
# 帳密登入關閉時，只有名單上「而且是公司工作空間 owner」的帳號能用帳密登入，每次寫 audit auth.break_glass。
# 有設時啟動與每天 09:00（COMPANY_TIMEZONE）會印 warning。緊急狀況解除後要拿掉並重新部署。
# 密碼用 `npm run auth:set-break-glass-password -- <email>` 從 stdin 設定，不要寫在任何設定檔。
BREAK_GLASS_OWNER_EMAILS=""
# 判斷「哪一天」用的時區（請假、打卡；H4 起使用）。預設 Asia/Taipei
COMPANY_TIMEZONE="Asia/Taipei"

# ── 公司帳號單一登入（Authentik OIDC）────────────────────────────────
# OIDC_ISSUER 有值時，GET /api/auth/config 回 sso=true，Flutter 登入頁顯示「使用公司帳號登入」；
# 不設 = SSO 關閉（/api/auth/oidc/* 回 404），後端照常啟動。
# Authentik 端的設定（Confidential client、RS256 signing key、scopes openid email profile）
# 見 docs/DEPLOY_DOKPLOY.md「Authentik 單一登入（H1）」。SSO 需要 Redis（state、ticket）。
# OIDC_ISSUER 必須跟 discovery 裡的 issuer 完全相同（包含結尾斜線）。
OIDC_ISSUER=""                 # 例：https://auth.example.com/application/o/oidea/
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""          # 只放後端；不要放進 Flutter 或任何前端設定
# 必須跟 Authentik provider 的 Redirect URI 一字不差
OIDC_REDIRECT_URI=""           # 例：https://api.oidea.example.com/api/auth/oidc/callback
# 登入完成後轉回 App 的位置：web 用 #ticket=…（fragment），mobile 用 ?ticket=…
APP_WEB_CALLBACK_URL=""        # 例：https://app.oidea.example.com/auth/callback
APP_MOBILE_CALLBACK_URL=""     # 不設時預設 oidea://auth
